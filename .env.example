# "remote" = images served from the existing WordPress media library (default)
# "local"  = images served from /public/media (run `npm run sync:media` first)
NEXT_PUBLIC_MEDIA_SOURCE=remote

# Used for canonical URLs, hreflang and the sitemap
NEXT_PUBLIC_SITE_URL=https://www.riad-anata.com

# Cooking-class booking.
# "message" (default) hands the request to WhatsApp/email from the browser —
# works with no backend. "api" posts to /api/booking instead.
NEXT_PUBLIC_BOOKING_MODE=message
# Needed only when BOOKING_MODE=api. Free tier at resend.com.
# RESEND_API_KEY=re_xxxxxxxx
# BOOKING_FROM="Riad Anata <reservations@riad-anata.com>"
